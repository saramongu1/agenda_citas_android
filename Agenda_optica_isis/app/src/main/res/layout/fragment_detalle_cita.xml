<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvDetalleId"
            android:text="ID:"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:layout_height="wrap_content"
            android:layout_width="match_parent" />
        <TextView
            android:id="@+id/tvDetallePacienteNombre"
            android:text="Paciente:"
            android:layout_height="wrap_content"
            android:layout_width="match_parent" />
        <TextView
            android:id="@+id/tvDetallePacienteDocumento"
            android:text="Documento:"
            android:layout_height="wrap_content"
            android:layout_width="match_parent" />
        <TextView
            android:id="@+id/tvDetalleOptometra"
            android:text="Optómetra:"
            android:layout_height="wrap_content"
            android:layout_width="match_parent" />
        <TextView
            android:id="@+id/tvDetalleFecha"
            android:text="Fecha:"
            android:layout_height="wrap_content"
            android:layout_width="match_parent" />
        <TextView
            android:id="@+id/tvDetalleHora"
            android:text="Hora:"
            android:layout_height="wrap_content"
            android:layout_width="match_parent" />
        <TextView
            android:id="@+id/tvDetalleEstado"
            android:text="Estado:"
            android:layout_height="wrap_content"
            android:layout_width="match_parent" />
        <TextView
            android:id="@+id/tvDetalleConsultorio"
            android:text="Consultorio:"
            android:layout_height="wrap_content"
            android:layout_width="match_parent" />

        <Button android:id="@+id/btnDetalleVolver"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver"/>
    </LinearLayout>
</ScrollView>
