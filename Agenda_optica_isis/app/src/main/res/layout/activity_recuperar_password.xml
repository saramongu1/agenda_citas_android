<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/candado"
                android:layout_marginBottom="16dp"
                app:tint="@color/azul" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recuperar Contraseña"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/azulOscuroGrisaseo"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingresa tu correo electrónico y te enviaremos un código de verificación"
                android:textSize="16sp"
                android:gravity="center"
                android:textColor="@color/grisNormal"
                android:lineSpacingExtra="4sp" />
        </LinearLayout>

        <!-- Campo Email -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/azul"
            app:hintTextColor="@color/azul">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Correo electrónico"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:drawableStart="@drawable/correo"
                android:drawablePadding="12dp"
                android:padding="16dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón Enviar Código -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Enviar código de verificación"
            android:textSize="16sp"
            android:padding="16dp"
            android:textAllCaps="false"
            app:icon="@drawable/baseline_send_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:backgroundTint="@color/azul" />

        <!-- Tiempo restante -->
        <TextView
            android:id="@+id/tvTiempoRestante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="@color/grisNormal"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Código de Verificación -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutCodigoVerificacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/azul"
            app:hintTextColor="@color/azul">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCodigoVerificacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Código de verificación"
                android:inputType="number"
                android:maxLines="1"
                android:maxLength="6"
                android:drawablePadding="12dp"
                android:padding="16dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón Verificar Código -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerificarCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Verificar código"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="16dp"
            app:cornerRadius="12dp"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:backgroundTint="@color/verdeeeee"
            android:visibility="gone" />

        <!-- Nueva Contraseña -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNuevaPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/azul"
            app:hintTextColor="@color/azul"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/azul">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNuevaPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nueva contraseña"
                android:inputType="textPassword"
                android:maxLines="1"
                android:drawableStart="@drawable/candado"
                android:drawablePadding="12dp"
                android:padding="16dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirmar Contraseña -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutConfirmarPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/azul"
            app:hintTextColor="@color/azul"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/azul">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmarPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Confirmar nueva contraseña"
                android:inputType="textPassword"
                android:maxLines="1"
                android:drawableStart="@drawable/candado"
                android:drawablePadding="12dp"
                android:padding="16dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón Cambiar Contraseña -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCambiarPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Cambiar contraseña"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="16dp"
            app:cornerRadius="12dp"
            app:icon="@drawable/candado"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:backgroundTint="@color/verdeeeee"
            android:visibility="gone" />

        <!-- Volver al Login -->
        <TextView
            android:id="@+id/tvVolverLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="← Volver al inicio de sesión"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/azul"
            android:padding="16dp"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>