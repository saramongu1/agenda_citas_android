<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardCita"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:background="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Pestaña de color según el estado -->
        <View
            android:id="@+id/estadoCitaView"
            android:layout_width="8dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp" />

        <!-- Contenedor principal -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvIdCitaAdapter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 001"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvPacienteCitaAdapter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paciente: Juan Pérez"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDocumentoPacienteCitaAdapter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Documento: 123456789" />

            <TextView
                android:id="@+id/tvOptometraCitaAdapter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Optómetra: Dra. López" />

            <TextView
                android:id="@+id/tvFechaHoraCitaAdapter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha: 2025-10-25 14:00" />

            <TextView
                android:id="@+id/tvEstadoCitaAdapter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado: Programada"
                android:textStyle="italic" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>

