<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título -->
        <TextView
            android:id="@+id/tituloAcercaDe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acerca de la aplicación"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="20dp" />

        <!-- Texto general -->
        <TextView
            android:id="@+id/descripcionAcercaDe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Esta aplicación ha sido desarrollada para optimizar la gestión de citas en la óptica."
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_marginBottom="25dp" />

        <!-- Atribución Flaticon (como lo exige Flaticon) -->
        <TextView
            android:id="@+id/atribucionFlaticon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Íconos creados por Freepik, Smashicons, Pixel perfect y Good Ware de Flaticon (www.flaticon.com)."
            android:textSize="14sp"
            android:textColor="@color/grisNormal"
            android:autoLink="web"
            android:layout_marginBottom="30dp" />

        <!-- Botón Manual de usuario -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManualUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manual de usuario"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="@color/azul"
            android:textColor="@color/white"
            app:cornerRadius="20dp"
            app:icon="@drawable/baseline_menu_book_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white"/>

    </LinearLayout>

</ScrollView>
